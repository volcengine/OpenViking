{
  "name": "@openviking/ui",
  "version": "0.0.0",
  "private": true,
  "description": "React UI modules for OpenViking applications.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/volcengine/OpenViking.git",
    "directory": "ui/packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/patterns/file-tree/file-tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./preview": {
      "types": "./dist/patterns/file-preview/file-preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./console": {
      "types": "./dist/patterns/command-console/command-console.d.ts",
      "import": "./dist/console.js"
    },
    "./viking-bot": {
      "types": "./dist/patterns/viking-bot/viking-bot.d.ts",
      "import": "./dist/viking-bot.js"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "dev": "rslib build --watch",
    "build": "rslib build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.5"
  }
}
