{
  "name": "openviking-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @openviking/ui-docs --",
    "check": "npm run check --workspaces --if-present",
    "build:lib": "npm run build --workspace @openviking/ui",
    "build:docs": "npm run build --workspace @openviking/ui-docs",
    "build": "npm run build:lib && npm run build:docs",
    "preview": "npm run preview --workspace @openviking/ui-docs --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
