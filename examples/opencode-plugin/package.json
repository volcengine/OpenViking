{
  "name": "@openviking/opencode-plugin",
  "version": "0.5.24",
  "author": "@openviking",
  "description": "Unified OpenCode plugin for OpenViking repository retrieval and long-term memory",
  "type": "module",
  "main": "index.mjs",
  "oc-plugin": [
    "server",
    "tui"
  ],
  "exports": {
    ".": "./index.mjs",
    "./servers/mcp-proxy.mjs": "./servers/mcp-proxy.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "servers/",
    "skills/",
    "scripts/",
    "README.md",
    "INSTALL.md",
    "INSTALL-ZH.md"
  ],
  "scripts": {
    "prepack": "node ../memory-plugin-shared/sync.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcengine/OpenViking.git",
    "directory": "examples/opencode-plugin"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openviking",
    "memory",
    "rag",
    "code-search"
  ],
  "license": "Apache-2.0"
}
