{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/session-start.mjs",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CODEBUDDY_PLUGIN_ROOT}/scripts/auto-recall.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
