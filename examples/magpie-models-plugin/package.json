{
  "name": "@openviking/magpie-models-plugin",
  "version": "0.1.0",
  "description": "Manage OpenViking and VikingBot models from Magpie",
  "author": "OpenViking",
  "homepage": "https://github.com/volcengine/OpenViking/tree/main/examples/magpie-models-plugin",
  "type": "module",
  "main": "./index.mjs",
  "magpie": {
    "name": "OpenViking",
    "icon": "https://raw.githubusercontent.com/volcengine/OpenViking/main/docs/images/ov-logo-icon.png",
    "agent": "./openviking.agent.js",
    "page": { "title": "OpenViking models", "titles": { "zh": "OpenViking 模型" }, "file": "page/index.html" },
    "panels": [
      {
        "slot": "agent",
        "agent": "openviking-models",
        "title": "Settings",
        "titles": {
          "zh": "设置"
        },
        "file": "page/index.html",
        "settings": {
          "groups": [
            {
              "title": "OpenViking VLM",
              "fields": [
                {
                  "key": "manageVlm",
                  "type": "boolean",
                  "title": "Manage with Magpie",
                  "titles": {
                    "zh": "由 Magpie 管理"
                  },
                  "default": true
                },
                {
                  "key": "vlmParameters.max_tokens",
                  "type": "integer",
                  "title": "Max output tokens",
                  "titles": {
                    "zh": "最大输出"
                  },
                  "optional": true,
                  "nullable": true,
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "when": {
                    "manageVlm": [
                      true
                    ]
                  }
                },
                {
                  "key": "vlmParameters.temperature",
                  "type": "number",
                  "title": "Temperature",
                  "titles": {
                    "zh": "温度"
                  },
                  "optional": true,
                  "nullable": true,
                  "minimum": 0,
                  "maximum": 2,
                  "when": {
                    "manageVlm": [
                      true
                    ]
                  }
                },
                {
                  "key": "vlmParameters.thinking",
                  "type": "boolean",
                  "title": "Thinking",
                  "titles": {
                    "zh": "思考模式"
                  },
                  "optional": true,
                  "when": {
                    "manageVlm": [
                      true
                    ]
                  }
                },
                {
                  "key": "vlmParameters.timeout",
                  "type": "number",
                  "title": "Timeout (seconds)",
                  "titles": {
                    "zh": "超时（秒）"
                  },
                  "optional": true,
                  "minimum": 5e-324,
                  "when": {
                    "manageVlm": [
                      true
                    ]
                  }
                }
              ]
            },
            {
              "title": "VikingBot",
              "fields": [
                {
                  "key": "botMode",
                  "type": "string",
                  "title": "Model",
                  "titles": {
                    "zh": "模型"
                  },
                  "default": "preserve",
                  "choices": [
                    {
                      "value": "preserve",
                      "title": "Keep existing settings",
                      "titles": {
                        "zh": "保留现有配置"
                      }
                    },
                    {
                      "value": "follow",
                      "title": "Follow OpenViking VLM",
                      "titles": {
                        "zh": "跟随 OpenViking VLM"
                      }
                    },
                    {
                      "value": "independent",
                      "title": "Independent model",
                      "titles": {
                        "zh": "独立选择模型"
                      }
                    }
                  ],
                  "description": "Only manages an enabled Bot; never enables it.",
                  "descriptions": {
                    "zh": "仅管理已启用的 Bot，不会自动开启。"
                  }
                },
                {
                  "key": "botModel",
                  "type": "string",
                  "title": "Model ID",
                  "titles": {
                    "zh": "模型 ID"
                  },
                  "when": {
                    "botMode": [
                      "independent"
                    ]
                  },
                  "description": "Leave empty to use the Agent selection.",
                  "descriptions": {
                    "zh": "留空使用 OpenViking 上方选中的模型。"
                  }
                },
                {
                  "key": "botParameters.max_tokens",
                  "type": "integer",
                  "title": "Max output tokens",
                  "titles": {
                    "zh": "最大输出"
                  },
                  "optional": true,
                  "nullable": true,
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "when": {
                    "botMode": [
                      "follow",
                      "independent"
                    ]
                  }
                },
                {
                  "key": "botParameters.temperature",
                  "type": "number",
                  "title": "Temperature",
                  "titles": {
                    "zh": "温度"
                  },
                  "optional": true,
                  "nullable": true,
                  "minimum": 0,
                  "maximum": 2,
                  "when": {
                    "botMode": [
                      "follow",
                      "independent"
                    ]
                  }
                },
                {
                  "key": "botParameters.thinking",
                  "type": "boolean",
                  "title": "Thinking",
                  "titles": {
                    "zh": "思考模式"
                  },
                  "optional": true,
                  "when": {
                    "botMode": [
                      "follow",
                      "independent"
                    ]
                  }
                },
                {
                  "key": "botParameters.timeout",
                  "type": "number",
                  "title": "Timeout (seconds)",
                  "titles": {
                    "zh": "超时（秒）"
                  },
                  "optional": true,
                  "minimum": 5e-324,
                  "when": {
                    "botMode": [
                      "follow",
                      "independent"
                    ]
                  }
                }
              ]
            },
            {
              "title": "Activation",
              "titles": {
                "zh": "生效方式"
              },
              "fields": [
                {
                  "key": "restartOnChange",
                  "type": "boolean",
                  "title": "Restart and verify automatically",
                  "titles": {
                    "zh": "自动重启并验证"
                  },
                  "default": false,
                  "description": "After synchronization. Managed Bot restarts with OV; restart standalone Bot separately.",
                  "descriptions": {
                    "zh": "同步后执行。受管 Bot 随 OV 重启；独立 Bot 需另行重启。保存设置不代表服务已生效。"
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "options": { "manageVlm": true, "botMode": "preserve", "pollMs": 2000 }
  },
  "files": ["index.mjs", "openviking.agent.js", "cli.mjs", "lib/", "page/", "README.md", "README_CN.md", "marketplace.json", "LICENSE"],
  "scripts": {
    "check": "node --check index.mjs && node --check openviking.agent.js && node --check cli.mjs && node --check lib/config.mjs && node --check lib/doctor.mjs && node --check lib/api.mjs && node --check lib/activation.mjs && node --check lib/files.mjs && node --check lib/plan.mjs && node --check lib/parameters.mjs && node --check lib/runtime.mjs && node --check page/app.js && node --check page/parameters.js",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/page.test.cjs"
  },
  "engines": { "node": ">=22.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/volcengine/OpenViking.git", "directory": "examples/magpie-models-plugin" },
  "keywords": ["magpie-plugin", "magpie-agent", "openviking", "vikingbot"],
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" }
}
