{
  "name": "@openviking/magpie-memory-plugin",
  "version": "0.1.1",
  "description": "OpenViking memory recall and tools for the Magpie model gateway",
  "type": "module",
  "main": "index.mjs",
  "magpie": { "hooks": "./hooks.mjs" },
  "files": ["index.mjs", "hooks.mjs", "runtime.mjs", "shared/", "README.md", "README_CN.md"],
  "scripts": {
    "prepack": "node ../memory-plugin-shared/sync.mjs",
    "check": "node --check index.mjs && node --check hooks.mjs && node --check runtime.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=22.19.0" },
  "keywords": ["magpie", "opencode-plugin", "openviking", "memory"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volcengine/OpenViking.git",
    "directory": "examples/magpie-memory-plugin"
  },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" }
