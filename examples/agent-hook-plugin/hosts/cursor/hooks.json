{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/hook.mjs sessionStart __OPENVIKING_CLIENT_ID__",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/hook.mjs beforeSubmitPrompt __OPENVIKING_CLIENT_ID__",
        "timeout": 20
      }
    ],
    "beforeReadFile": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/uri-guard.mjs __OPENVIKING_CLIENT_ID__",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/uri-guard.mjs __OPENVIKING_CLIENT_ID__",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/hook.mjs stop __OPENVIKING_CLIENT_ID__",
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/hook.mjs preCompact __OPENVIKING_CLIENT_ID__",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "node __OPENVIKING_PLUGIN_ROOT__/scripts/hook.mjs sessionEnd __OPENVIKING_CLIENT_ID__",
        "timeout": 30
      }
    ]
  }
}
