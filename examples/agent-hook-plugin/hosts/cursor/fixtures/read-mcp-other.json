{
  "what": "a tool on another MCP server keeps that server's name",
  "read": {
    "event": "afterMCPExecution",
    "payload": {
      "conversation_id": "c1",
      "transcript_path": "t.jsonl",
      "tool_use_id": "read-1",
      "tool_name": "read",
      "mcp_server_name": "user-other",
      "tool_input": "{\"uris\":\"viking://~/memories/x.md\"}",
      "result_json": "{\"content\":[{\"type\":\"text\",\"text\":\"body\"}],\"isError\":false}"
    },
    "transcript": "tools.jsonl"
  },
  "expect": {
    "note": {
      "afterTurn": 3,
      "tool": {
        "type": "tool_result",
        "tool_use_id": "read-1",
        "name": "mcp__other__read",
        "state": {
          "input": {
            "uris": "viking://~/memories/x.md"
          },
          "output": {
            "content": [
              {
                "type": "text",
                "text": "body"
              }
            ],
            "isError": false
          }
        },
        "is_error": false
      }
    }
  }
}
