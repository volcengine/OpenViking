# Required
LLAMA_CLOUD_API_KEY=llx-replace-me
PARSER_BRIDGE_API_KEY=replace-me

# Select the LlamaCloud region that issued the API key: na or eu.
LLAMAPARSE_REGION=na

# Parsing defaults
LLAMAPARSE_TIER=agentic
LLAMAPARSE_VERSION=latest
LLAMAPARSE_COST_OPTIMIZER=true

# Bridge network settings
BRIDGE_PUBLIC_URL=http://127.0.0.1:8080
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_PORT=8080

# Advanced settings
# LLAMAPARSE_PARSE_OPTIONS_JSON={"input_options":{"spreadsheet":{"detect_sub_tables_in_sheets":true}}}
# LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai
# LLAMAPARSE_ORGANIZATION_ID=
# LLAMAPARSE_PROJECT_ID=
# BRIDGE_HTTP_TIMEOUT_SECONDS=120
# BRIDGE_ARTIFACT_TTL_SECONDS=300
