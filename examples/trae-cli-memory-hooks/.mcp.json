{
  "mcpServers": {
    "openviking-memory": {
      "command": "node",
      "args": [
        "servers/mcp-proxy.mjs"
      ],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "env_vars": [
        "OPENVIKING_CLI_CONFIG_FILE",
        "OPENVIKING_CONFIG_FILE",
        "OPENVIKING_URL",
        "OPENVIKING_BASE_URL",
        "OPENVIKING_MCP_URL",
        "OPENVIKING_API_KEY",
        "OPENVIKING_BEARER_TOKEN",
        "OPENVIKING_ACCOUNT",
        "OPENVIKING_USER",
        "OPENVIKING_PEER_ID",
        "OPENVIKING_CREDENTIAL_SOURCE",
        "OPENVIKING_CREDENTIALS_SOURCE",
        "OPENVIKING_TIMEOUT_MS",
        "OPENVIKING_INTEGRATION_VERSION",
        "OPENVIKING_DEBUG",
        "OPENVIKING_DEBUG_LOG"
      ]
    }
  }
}
