flowchart LR
    %% 样式定义
    classDef stageCard fill:#FFFFFF,stroke:#3B82F6,stroke-width:2px,color:#1E3A5F,font-weight:bold
    classDef stageCard2 fill:#FFFFFF,stroke:#8B5CF6,stroke-width:2px,color:#4C1D95,font-weight:bold
    classDef stageCard3 fill:#FFFFFF,stroke:#10B981,stroke-width:2px,color:#065F46,font-weight:bold
    classDef stageCard4 fill:#FFFFFF,stroke:#F59E0B,stroke-width:2px,color:#92400E,font-weight:bold
    classDef itemBox fill:#EFF6FF,stroke:#BFDBFE,stroke-width:1px,color:#334155
    classDef itemBox2 fill:#F5F3FF,stroke:#DDD6FE,stroke-width:1px,color:#334155
    classDef itemBox3 fill:#ECFDF5,stroke:#A7F3D0,stroke-width:1px,color:#334155
    classDef itemBox4 fill:#FFFBEB,stroke:#FDE68A,stroke-width:1px,color:#334155
    classDef headerBar fill:#3B82F6,stroke:#3B82F6,color:#FFFFFF,font-weight:bold
    classDef headerBar2 fill:#8B5CF6,stroke:#8B5CF6,color:#FFFFFF,font-weight:bold
    classDef headerBar3 fill:#10B981,stroke:#10B981,color:#FFFFFF,font-weight:bold
    classDef headerBar4 fill:#F59E0B,stroke:#F59E0B,color:#FFFFFF,font-weight:bold
    classDef arrowLabel fill:#FFFFFF,stroke:#CBD5E1,color:#64748B,font-size:12px

    %% ===== 阶段1：写入 =====
    subgraph S1 [" "]
        direction TB
        H1["① 写入 / Ingestion"]:::headerBar
        I1["源获取<br/>本地文件 / URL / Git / 飞书 / Connector"]:::itemBox
        I2["Accessor 路由<br/>按优先级自动匹配源类型"]:::itemBox
        I3["目标 URI 解析<br/>to / parent / 自动推导"]:::itemBox
        I4["写入 VikingFS<br/>TreeBuilder 结构化存储"]:::itemBox
        F1["6 种 HTTP 入口 · 3 种 MCP 工具<br/>Watch 调度 · Connector 数据流"]
    end

    %% ===== 阶段2：后处理 =====
    subgraph S2 [" "]
        direction TB
        H2["② 后处理 / Post-process"]:::headerBar2
        J1["解析结构化<br/>文本 / 图片 / 表格 / 代码"]:::itemBox2
        J2["向量化 (VikingDB)<br/>chunk 切分 + embedding 索引"]:::itemBox2
        J3["语义层级摘要<br/>L0 文件级 / L1 目录级 .abstract.md"]:::itemBox2
        J4["目录元数据索引<br/>目录本身可被语义检索命中"]:::itemBox2
        J5["ACL / 标签<br/>创建者自动授权 + 检索标签"]:::itemBox2
        F2["两阶段提交：SOURCE → POST_PROCESS"]
    end

    %% ===== 阶段3：消费 =====
    subgraph S3 [" "]
        direction TB
        H3["③ 消费 / Consumption"]:::headerBar3
        K1["向量检索<br/>POST /api/v1/search/search<br/>VikingDB 相似度搜索"]:::itemBox3
        K2["上下文组装<br/>自动注入对话上下文"]:::itemBox3
        K3["文件级访问<br/>read / tree / WebDAV"]:::itemBox3
        K4["Watch 自动刷新<br/>定时重新拉取源并覆盖"]:::itemBox3
        K5["MCP 工具<br/>Agent 直接读写检索"]:::itemBox3
        F3["全局共享 · 所有用户默认可见"]
    end

    %% ===== 阶段4：维护删除 =====
    subgraph S4 [" "]
        direction TB
        H4["④ 维护删除 / Maintenance"]:::headerBar4
        L1["更新 / 覆盖<br/>write / edit / reimport"]:::itemBox4
        L2["删除清理<br/>rm / recursive"]:::itemBox4
        L3["索引同步<br/>语义刷新 + 向量删除"]:::itemBox4
        L4["Watch 联动停用<br/>目标被删自动停用"]:::itemBox4
        L5["记忆链接清理<br/>防止悬空引用"]:::itemBox4
        F4["删除联动 · 自动级联"]
    end

    %% 主流程箭头
    S1 -->|"触发"| S2
    S2 -->|"可检索"| S3
    S3 -->|"变更"| S4

    %% 闭环虚线
    S4 -.->|"删除后可重新写入"| S1

    %% 布局调整
    style S1 fill:#F8FAFC,stroke:#BFDBFE,stroke-width:1px
    style S2 fill:#F8FAFC,stroke:#DDD6FE,stroke-width:1px
    style S3 fill:#F8FAFC,stroke:#A7F3D0,stroke-width:1px
    style S4 fill:#F8FAFC,stroke:#FDE68A,stroke-width:1px
