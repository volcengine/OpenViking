{
  "name": "@openviking/react",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "React UI modules for OpenViking applications.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/volcengine/OpenViking.git",
    "directory": "frontend/packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.arco-design"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/file-tree": {
      "types": "./dist/components/file-tree/index.d.ts",
      "import": "./dist/components/file-tree.js"
    },
    "./components/file-tree/style.css": "./dist/components/file-tree/style.css",
    "./components/file-preview": {
      "types": "./dist/components/file-preview/index.d.ts",
      "import": "./dist/components/file-preview.js"
    },
    "./components/file-preview/style.css": "./dist/components/file-preview/style.css",
    "./components/file-browser-entries": {
      "types": "./dist/components/file-browser-entries/index.d.ts",
      "import": "./dist/components/file-browser-entries.js"
    },
    "./components/file-browser-entries/style.css": "./dist/components/file-browser-entries/style.css",
    "./components/tui": {
      "types": "./dist/components/tui/index.d.ts",
      "import": "./dist/components/tui.js"
    },
    "./components/tui/style.css": "./dist/components/tui/style.css",
