{
  "name": "@openviking/react",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "React UI modules for OpenViking applications.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/volcengine/OpenViking.git",
    "directory": "frontend/packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/status-badge": {
      "types": "./dist/components/status-badge/status-badge.d.ts",
      "import": "./dist/components/status-badge.js"
    },
    "./components/status-badge/style.css": "./dist/components/status-badge/style.css",
    "./components/file-tree": {
      "types": "./dist/components/file-tree/file-tree.d.ts",
      "import": "./dist/components/file-tree.js"
    },
    "./components/file-tree/style.css": "./dist/components/file-tree/style.css",
    "./components/file-preview": {
      "types": "./dist/components/file-preview/file-preview.d.ts",
      "import": "./dist/components/file-preview.js"
    },
    "./components/file-preview/style.css": "./dist/components/file-preview/style.css",
    "./components/tui": {
      "types": "./dist/components/tui/tui.d.ts",
      "import": "./dist/components/tui.js"
    },
    "./components/tui/style.css": "./dist/components/tui/style.css",
    "./components/viking-bot": {
      "types": "./dist/components/viking-bot/viking-bot.d.ts",
      "import": "./dist/components/viking-bot.js"
    },
    "./components/viking-bot/style.css": "./dist/components/viking-bot/style.css",
    "./components/scope-switcher": {
      "types": "./dist/components/scope-switcher/scope-switcher.d.ts",
      "import": "./dist/components/scope-switcher.js"
    },
    "./components/scope-switcher/style.css": "./dist/components/scope-switcher/style.css",
    "./components/agent-connect": {
      "types": "./dist/components/agent-connect/agent-connect.d.ts",
      "import": "./dist/components/agent-connect.js"
    },
    "./components/agent-connect/style.css": "./dist/components/agent-connect/style.css",
    "./components/resource-import": {
      "types": "./dist/components/resource-import/resource-import.d.ts",
      "import": "./dist/components/resource-import.js"
    },
    "./components/resource-import/style.css": "./dist/components/resource-import/style.css",
    "./style.css": "./dist/style.css",
    "./components/style.css": "./dist/components/style.css",
    "./package.json": "./package.json",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons.js"
    }
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@ark-design/ui": "^0.0.0-beta.5"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.5",
    "@ark-design/ui": "0.0.0-beta.5"
  },
  "peerDependenciesMeta": {
    "@ark-design/ui": {
      "optional": true
    }
  }
}
