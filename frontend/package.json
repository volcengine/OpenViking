{
  "name": "openviking-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @openviking/ui-docs --",
    "check": "npm run lint",
    "lint": "npm run build:lib && node scripts/lint.mjs",
    "lint:fix": "npm run build:lib && node scripts/lint.mjs --fix",
    "typecheck": "npm run build:lib && tsc --noEmit -p packages/react/tsconfig.json && tsc --noEmit -p packages/react/tsconfig.config.json && tsc --noEmit -p docs/tsconfig.json",
    "test": "npm run build:lib && node --test scripts/package.test.mjs",
    "build:lib": "npm run build --workspace @openviking/react",
    "build:docs": "npm run build --workspace @openviking/ui-docs",
    "build": "npm run build:lib && npm run build:docs",
    "preview": "npm run preview --workspace @openviking/ui-docs --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@rslint/core": "0.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "7.0.2"
  }
}
