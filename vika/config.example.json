{
  "version": 1,
  "defaultInstance": "primary",
  "env": {
    "LARK_CLI_BIN": "",
    "CODEX_BIN": "",
    "TRAEX_BIN": "",
    "CLAUDE_BIN": "claude",
    "PI_BIN": "",
    "VIKA_WEIXIN_LONG_POLL_TIMEOUT_MS": "35000",
    "VIKA_LOG_LEVEL": "info",
    "VIKA_DRY_RUN": "false",
    "VIKA_IGNORED_SENDER_IDS": "",
    "VIKA_SEND_TIMEOUT_MS": "30000",
    "VIKA_SHUTDOWN_TIMEOUT_MS": "20000",
    "VIKA_MAX_REPLY_CHARS": "30000",
    "VIKA_MAX_EVENT_BYTES": "1000000",
    "VIKA_MAX_EVENT_AGE_MS": "86400000",
    "VIKA_IDLE_REACTION_AFTER_MS": "600000",
    "VIKA_TIMER_OCCURRENCE_CHECK_DELAY_MS": "300000",
    "VIKA_RETENTION_MS": "7776000000",
    "VIKA_CODEX_EFFORT": "medium",
    "VIKA_TRAEX_EFFORT": "medium",
    "VIKA_CLAUDE_EFFORT": "medium",
    "VIKA_CLAUDE_MODEL": "",
    "VIKA_PI_EFFORT": "medium",
    "VIKA_PI_MODEL": "",
    "FALLBACK_MODEL": "gpt-5.6-sol",
    "VIKA_HISTORY_LIMIT": "30"
  },
  "agents": [
    {
      "id": "primary",
      "displayName": "Primary Agent",
      "channel": "lark",
      "connectors": ["lark"],
      "profile": "cli_primary",
      "port": 3738,
      "dataDir": "/Users/you/.vika/data/primary",
      "workspace": "/Users/you/Documents/work/primary-workspace",
      "ovConfig": "/Users/you/.openviking/ovcli.conf.primary",
      "ovAutoRecall": false,
      "explicitSilence": false,
      "stagedReplies": false,
      "role": "assistant",
      "naturalWriting": true,
      "model": "codex"
    },
    {
      "id": "research",
      "displayName": "Research Agent",
      "channel": "lark",
      "connectors": ["lark"],
      "profile": "cli_research",
      "port": 3740,
      "dataDir": "/Users/you/.vika/data/research",
      "workspace": "/Users/you/Documents/work/research-workspace",
      "ovConfig": "/Users/you/.openviking/ovcli.conf.research",
      "ovAutoRecall": false,
      "explicitSilence": false,
      "stagedReplies": false,
      "role": "/Users/you/.vika/roles/research.md",
      "naturalWriting": false,
      "model": "gpt-5.6-sol"
    }
  ]
}
