# Shared runtime copies generated by examples/memory-plugin-shared/sync.mjs.
# Only the plugins a host installs by pointing at a directory in this repository
# keep their copies in git; the rest are built at pack time and gitignored.
examples/claude-code-memory-plugin/scripts/shared/*.mjs linguist-generated=true
examples/codex-memory-plugin/scripts/shared/*.mjs linguist-generated=true
agent-plugins/servers/shared/*.mjs linguist-generated=true

# Regenerated by the TanStack Router plugin during every Studio build, which
# writes LF. Pin LF so Windows checkouts (core.autocrlf=true) stay clean.
web-studio/src/routeTree.gen.ts text eol=lf
