{
  "apps": [
    {
      "interpreter": "<NODE>",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "wait_ready": true,
      "time": false,
      "merge_logs": true,
      "filter_env": [
        "OPENVIKING_"
      ],
      "name": "superagent-primary",
      "script": "<RELEASE>/packages/daemon/src/main.mjs",
      "cwd": "<RELEASE>/packages/daemon",
      "restart_delay": 2000,
      "min_uptime": "30s",
      "max_restarts": 10,
      "kill_timeout": 30000,
      "listen_timeout": 30000,
      "env": {
        "NODE_ENV": "production",
        "OV_SUPERAGENT_CONFIG": "<HOME>/config.json",
        "OV_SUPERAGENT_INSTANCE_ID": "primary",
        "OV_SUPERAGENT_UPGRADE_TARGET": "primary",
        "OV_SUPERAGENT_HOST": "127.0.0.1",
        "OV_SUPERAGENT_HTTP_ENABLED": "true",
        "OV_SUPERAGENT_CHANNEL": "lark",
        "OV_SUPERAGENT_CONNECTORS_JSON": "[\"lark\"]",
        "OV_SUPERAGENT_PORT": "3738",
        "OV_SUPERAGENT_LARK_PROFILE": "test",
        "LARKSUITE_CLI_PROFILE": "test",
        "OV_SUPERAGENT_AGENT_NAME": "Primary",
        "OV_SUPERAGENT_DATA_DIR": "<HOME>/data",
        "OV_SUPERAGENT_TEMP_DIR": "",
        "OV_SUPERAGENT_WORKSPACE": "<HOME>/work",
        "OV_SUPERAGENT_MODEL": "durable",
        "OV_SUPERAGENT_VOLC_SESSION_ID": "",
        "OV_SUPERAGENT_VOLC_ENVIRONMENT_ID": "",
        "OPENVIKING_CLI_CONFIG_FILE": "<HOME>/ov.json",
        "OPENVIKING_CREDENTIAL_SOURCE": "cli",
        "OPENVIKING_MEMORY_ENABLED": "0",
        "OPENVIKING_AUTO_RECALL": "0",
        "OPENVIKING_AUTO_CAPTURE": "0",
        "OPENVIKING_AUTO_COMMIT_ON_COMPACT": "0",
        "OPENVIKING_TAKEOVER": "0",
        "OPENVIKING_WORKSPACE_PEER": "0",
        "OPENVIKING_RECALL_PEER_SCOPE": "all",
        "OPENVIKING_HOME": "<HOME>/data/openviking",
        "OPENVIKING_STATE_DIR": "<HOME>/data/openviking/state",
        "OPENVIKING_HOOK_STATE_DIR": "<HOME>/data/openviking/hook-state",
        "OPENVIKING_CODEX_STATE_DIR": "<HOME>/data/openviking/codex-plugin-state",
        "OPENVIKING_PENDING_DIR": "<HOME>/data/openviking/pending",
        "OPENVIKING_RECALL_LEDGER_DIR": "<HOME>/data/openviking/recall-ledger",
        "PATH": "/fixture/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "interpreter": "<NODE>",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "wait_ready": true,
      "time": false,
      "merge_logs": true,
      "filter_env": [
        "OPENVIKING_",
        "ARK_",
        "VOLCENGINE_",
        "OV_SUPERAGENT_VOLC_",
        "SESSION_ID"
      ],
      "name": "superagent-web",
      "script": "<RELEASE>/packages/web/src/main.mjs",
      "cwd": "<RELEASE>/packages/web",
      "restart_delay": 1000,
      "min_uptime": "10s",
      "max_restarts": 10,
      "kill_timeout": 5000,
      "listen_timeout": 10000,
      "env": {
        "NODE_ENV": "production",
        "OV_SUPERAGENT_WEB_HOST": "127.0.0.1",
        "OV_SUPERAGENT_WEB_PORT": "3737",
        "OV_SUPERAGENT_WEB_DEFAULT_INSTANCE": "primary",
        "OV_SUPERAGENT_WEB_INSTANCES": "[{\"id\":\"primary\",\"label\":\"Primary\",\"host\":\"127.0.0.1\",\"port\":3738}]",
        "PATH": "/fixture/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "interpreter": "<NODE>",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "wait_ready": true,
      "time": false,
      "merge_logs": true,
      "filter_env": [
        "OPENVIKING_"
      ],
      "name": "superagent-updater",
      "script": "<RELEASE>/packages/updater/src/main.mjs",
      "cwd": "<RELEASE>/packages/updater",
      "restart_delay": 1000,
      "min_uptime": "10s",
      "max_restarts": 10,
      "kill_timeout": 5000,
      "listen_timeout": 10000,
      "env": {
        "NODE_ENV": "production",
        "OV_SUPERAGENT_CONFIG": "<HOME>/config.json",
        "OV_SUPERAGENT_UPDATER_RELEASE_LINK": "<HOME>/.superagent/current",
        "OV_SUPERAGENT_UPDATER_SOCKET": "<HOME>/.superagent/updater.sock",
        "PM2_HOME": "<HOME>/.superagent/pm2",
        "PM2_BIN": "<RELEASE>/bin/pm2",
        "PATH": "/fixture/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  ]
}
