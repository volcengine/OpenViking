{
  "version": 1,
  "defaultInstance": "primary",
  "env": {
    "LARK_CLI_BIN": "",
    "CODEX_BIN": "",
    "TRAEX_BIN": "",
    "CLAUDE_BIN": "claude",
    "PI_BIN": "",
    "OPENCODE_BIN": "",
    "AGY_BIN": "",
    "DSH_BIN": "dsh",
    "OV_SUPERAGENT_WEIXIN_LONG_POLL_TIMEOUT_MS": "35000",
    "OV_SUPERAGENT_LOG_LEVEL": "info",
    "OV_SUPERAGENT_DRY_RUN": "false",
    "OV_SUPERAGENT_IGNORED_SENDER_IDS": "",
    "OV_SUPERAGENT_SEND_TIMEOUT_MS": "30000",
    "OV_SUPERAGENT_OV_TOOL_TIMEOUT_MS": "20000",
    "OV_SUPERAGENT_SHUTDOWN_TIMEOUT_MS": "20000",
    "OV_SUPERAGENT_MAX_REPLY_CHARS": "30000",
    "OV_SUPERAGENT_MAX_EVENT_BYTES": "1000000",
    "OV_SUPERAGENT_MAX_EVENT_AGE_MS": "86400000",
    "OV_SUPERAGENT_IDLE_REACTION_AFTER_MS": "600000",
    "OV_SUPERAGENT_TIMER_OCCURRENCE_CHECK_DELAY_MS": "300000",
    "OV_SUPERAGENT_RETENTION_MS": "7776000000",
    "OV_SUPERAGENT_CODEX_EFFORT": "medium",
    "OV_SUPERAGENT_TRAEX_EFFORT": "medium",
    "OV_SUPERAGENT_CLAUDE_EFFORT": "medium",
    "OV_SUPERAGENT_CLAUDE_MODEL": "",
    "OV_SUPERAGENT_PI_EFFORT": "medium",
    "OV_SUPERAGENT_PI_MODEL": "",
    "OV_SUPERAGENT_DURABLE_EFFORT": "medium",
    "OV_SUPERAGENT_DURABLE_MODEL": "",
    "OV_SUPERAGENT_OPENCODE_MODEL": "",
    "OV_SUPERAGENT_AGY_MODEL": "",
    "FALLBACK_MODEL": "gpt-5.6-sol",
    "OV_SUPERAGENT_HISTORY_LIMIT": "30"
  },
  "agents": [
    {
      "id": "primary",
      "displayName": "Primary Agent",
      "channel": "lark",
      "connectors": ["lark"],
      "profile": "cli_primary",
      "port": 3738,
      "dataDir": "/Users/you/.superagent/data/primary",
      "workspace": "/Users/you/Documents/work/primary-workspace",
      "ovConfig": "/Users/you/.openviking/ovcli.conf.primary",
      "ovAutoRecall": false,
      "explicitSilence": true,
      "stagedReplies": false,
      "role": "assistant",
      "naturalWriting": true,
      "model": "codex"
    },
    {
      "id": "research",
      "displayName": "Research Agent",
      "channel": "lark",
      "connectors": ["lark"],
      "profile": "cli_research",
      "port": 3740,
      "dataDir": "/Users/you/.superagent/data/research",
      "workspace": "/Users/you/Documents/work/research-workspace",
      "ovConfig": "/Users/you/.openviking/ovcli.conf.research",
      "ovAutoRecall": false,
      "explicitSilence": true,
      "stagedReplies": false,
      "role": "/Users/you/.superagent/roles/research.md",
      "naturalWriting": false,
      "model": "gpt-5.6-sol"
    }
  ]
}
