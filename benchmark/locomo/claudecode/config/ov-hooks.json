{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${OPENVIKING_PLUGIN_DIR}/scripts/hook.mjs SessionStart claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${OPENVIKING_PLUGIN_DIR}/scripts/hook.mjs UserPromptSubmit claude-code",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${LOCOMO_BENCHMARK_DIR}/scripts/capture.mjs Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${LOCOMO_BENCHMARK_DIR}/scripts/capture.mjs PreCompact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${LOCOMO_BENCHMARK_DIR}/scripts/capture.mjs SessionEnd",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
