{
  "service": {
    "max_active_tasks": 1,
    "port": 8765,
    "dataset": "ark-viking-local-smoke-20260907"
  },
  "viking": {
    "base_url": "https://viking-exp.byted.org",
    "api_token": "YOUR_VIKING_API_TOKEN",
    "template_task_id": 3327,
    "group_timeout_seconds": {"group_1": 1800},
    "group_concurrency": {
      "group_2": 20,
      "group_3": 20,
      "group_4": 20
    },
    "train": {
      "experiment_set_id": 300,
      "version": "V11"
    },
    "eval": {
      "experiment_set_id": 300,
      "version": "V11"
    },
    "task_time_limit_seconds": 14400,
    "sandbox_config": {
      "env": "stg",
      "collect_traces": true,
      "extra_headers": {
        "from-ark-console": "true",
        "x-tt-env": "ai_search_homepage_stg",
        "x-tt-sandbox": "{\"multi-agents-md-id\":\"stg-default-agentmd-20260901\",\"env\":{\"VAKA_REQUEST_SOURCE\":\"ark-lx\"}}",
        "x-vaka-request-source": "ark-lx",
        "x-tt-backend": "evolving"
      },
      "extra_payload": {
        "extra_data": {
          "extra": {
            "memory": {
              "enabled": false
            }
          }
        }
      }
    }
  },
  "memory_proxy": {
    "enabled": false
  },
  "kubevpn": {
    "kubeconfig": "/absolute/path/to/kubeconfig",
    "namespace": "ai-search-rec",
    "openviking_target": "evolving-dutao"
  }
}
